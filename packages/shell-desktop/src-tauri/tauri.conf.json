{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Desktop Shell",
	"version": "0.1.0",
	"identifier": "com.agsched.desktop",
	"build": {
		"frontendDist": "../../web/dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Desktop Shell",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
