{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Desktop Shell",
	"version": "0.1.0",
	"identifier": "com.agsched.desktop",
	"build": {
		"frontendDist": "../../web/dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Desktop Shell",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; img-src 'self' asset: https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"gen/daemon-runtime": "daemon-runtime",
			"../../web/dist": "web/dist"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": {
				"depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37", "libgtk-3-0"]
			}
		}
	}
}
