{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"organizeImports": {
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error"
			},
			"suspicious": {}
		}
	},
	"files": {
		"ignore": [
			"docs/**",
			"_env-check/**",
			"_preview/**",
			"**/dist/**",
			"**/node_modules/**",
			"packages/shell-desktop/src-tauri/target/**",
			"packages/shell-desktop/src-tauri/gen/**",
			"AGENTS.md",
			"CLAUDE.md",
			"packages/daemon/test/fixtures/agents.json",
			"packages/daemon/test/fixtures/pairing-code.txt",
			"e2e/**"
		]
	}
}
